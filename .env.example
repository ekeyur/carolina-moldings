# Resend (https://resend.com) — powers /api/contact and /api/quote
RESEND_API_KEY=

# Destination inbox for the contact form. Defaults to contact@carolinamoldings.com if unset.
CONTACT_TO_EMAIL=contact@carolinamoldings.com

# Destination inbox for quote requests. Defaults to CONTACT_TO_EMAIL if unset.
# QUOTE_TO_EMAIL=

# "From" address emails are sent as. Must be on a domain verified in Resend
# (Resend dashboard → Domains) or delivery will be rejected/spam-filtered.
# Defaults to Resend's shared sandbox domain, which only works for testing.
# EMAIL_FROM=Carolina Moldings Website <noreply@carolinamoldings.com>

# CARTO basemaps (https://carto.com) — powers the location map on /contact.
# Appended as ?key= to the raster tile URL; exposed to the browser, so restrict
# it by domain in the CARTO dashboard.
NEXT_PUBLIC_CARTO_MAP_KEY=
